<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Instructor" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.50.1">
  <bpmn:collaboration id="Collaboration_Instructor">
    <bpmn:participant id="Participant_Instructor" name="Usuario / Instructor" processRef="Process_Instructor" />
    <bpmn:participant id="Participant_Sistema" name="Sistema (Autenticación y Backend)" processRef="Process_Sistema" />
    <bpmn:messageFlow id="MessageFlow_EnviarCredenciales" name="Enviar Credenciales" sourceRef="Task_Ingresar" targetRef="Task_Validar" />
    <bpmn:messageFlow id="MessageFlow_LoginOK" name="Sí" sourceRef="Gateway_Validacion" targetRef="Task_CargarPanel" />
    <bpmn:messageFlow id="MessageFlow_LoginError" name="No" sourceRef="Gateway_Validacion" targetRef="Task_Ingresar" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Instructor" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="Acceso a la Plataforma">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_Ingresar" name="Ingresar Correo y Contraseña">
      <bpmn:incoming>Flow_1</bpmn:incoming>
    </bpmn:userTask>
    <bpmn:userTask id="Task_CargarPanel" name="Cargar Panel Principal (Instructor)">
      <bpmn:outgoing>Flow_Menu</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Menu" name="Seleccionar Opción Menú">
      <bpmn:incoming>Flow_Menu</bpmn:incoming>
      <bpmn:outgoing>Flow_IrHorario</bpmn:outgoing>
      <bpmn:outgoing>Flow_IrDisponibilidad</bpmn:outgoing>
      <bpmn:outgoing>Flow_IrSeguimiento</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_1" name="Gestión Finalizada">
      <bpmn:incoming>Flow_Fin1</bpmn:incoming>
      <bpmn:incoming>Flow_Fin2</bpmn:incoming>
      <bpmn:incoming>Flow_Fin3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_Ingresar" />
    <bpmn:sequenceFlow id="Flow_Menu" sourceRef="Task_CargarPanel" targetRef="Gateway_Menu" />
    <bpmn:sequenceFlow id="Flow_IrHorario" name="Mi horario" sourceRef="Gateway_Menu" targetRef="Task_ConsultarHorario" />
    <bpmn:sequenceFlow id="Flow_IrDisponibilidad" name="Mi disponibilidad" sourceRef="Gateway_Menu" targetRef="Task_GestionarDisponibilidad" />
    <bpmn:sequenceFlow id="Flow_IrSeguimiento" name="Seguimiento" sourceRef="Gateway_Menu" targetRef="Task_RegistrarSeguimiento" />
    <bpmn:sequenceFlow id="Flow_Fin1" sourceRef="Task_ConsultarHorario" targetRef="EndEvent_1" />
    <bpmn:sequenceFlow id="Flow_Fin2" sourceRef="Task_GestionarDisponibilidad" targetRef="EndEvent_1" />
    <bpmn:sequenceFlow id="Flow_Fin3" sourceRef="Task_RegistrarSeguimiento" targetRef="EndEvent_1" />
    <bpmn:userTask id="Task_GestionarDisponibilidad" name="Gestionar Mi Disponibilidad">
      <bpmn:incoming>Flow_IrDisponibilidad</bpmn:incoming>
      <bpmn:outgoing>Flow_Fin2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_ConsultarHorario" name="Consultar Mi Horario">
      <bpmn:incoming>Flow_IrHorario</bpmn:incoming>
      <bpmn:outgoing>Flow_Fin1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_RegistrarSeguimiento" name="Registrar Seguimiento de Ficha">
      <bpmn:incoming>Flow_IrSeguimiento</bpmn:incoming>
      <bpmn:outgoing>Flow_Fin3</bpmn:outgoing>
    </bpmn:userTask>
  </bpmn:process>
  <bpmn:process id="Process_Sistema" isExecutable="true">
    <bpmn:serviceTask id="Task_Validar" name="Validar Credenciales y Rol">
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Validacion" name="¿Credenciales Válidas?">
      <bpmn:incoming>Flow_3</bpmn:incoming>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_Validar" targetRef="Gateway_Validacion" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_Instructor">
      <bpmndi:BPMNShape id="Participant_Instructor_di" bpmnElement="Participant_Instructor" isHorizontal="true">
        <dc:Bounds x="130" y="80" width="950" height="230" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="182" y="162" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Ingresar_di" bpmnElement="Task_Ingresar">
        <dc:Bounds x="250" y="140" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CargarPanel_di" bpmnElement="Task_CargarPanel">
        <dc:Bounds x="460" y="140" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Menu_di" bpmnElement="Gateway_Menu" isMarkerVisible="true">
        <dc:Bounds x="595" y="155" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_1_di" bpmnElement="EndEvent_1">
        <dc:Bounds x="932" y="162" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="977.5" y="166" width="51" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_GestionarDisponibilidad_di" bpmnElement="Task_GestionarDisponibilidad">
        <dc:Bounds x="735" y="160" width="110" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ConsultarHorario_di" bpmnElement="Task_ConsultarHorario">
        <dc:Bounds x="735" y="90" width="110" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RegistrarSeguimiento_di" bpmnElement="Task_RegistrarSeguimiento">
        <dc:Bounds x="735" y="230" width="110" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="218" y="180" />
        <di:waypoint x="250" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Menu_di" bpmnElement="Flow_Menu">
        <di:waypoint x="560" y="180" />
        <di:waypoint x="595" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_IrHorario_di" bpmnElement="Flow_IrHorario">
        <di:waypoint x="620" y="155" />
        <di:waypoint x="620" y="120" />
        <di:waypoint x="735" y="120" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="615" y="128" width="49" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_IrDisponibilidad_di" bpmnElement="Flow_IrDisponibilidad">
        <di:waypoint x="645" y="180" />
        <di:waypoint x="735" y="180" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="650" y="155" width="82" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_IrSeguimiento_di" bpmnElement="Flow_IrSeguimiento">
        <di:waypoint x="620" y="205" />
        <di:waypoint x="620" y="260" />
        <di:waypoint x="735" y="260" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="589" y="233" width="62" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Fin1_di" bpmnElement="Flow_Fin1">
        <di:waypoint x="845" y="120" />
        <di:waypoint x="950" y="120" />
        <di:waypoint x="950" y="162" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Fin2_di" bpmnElement="Flow_Fin2">
        <di:waypoint x="845" y="180" />
        <di:waypoint x="932" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Fin3_di" bpmnElement="Flow_Fin3">
        <di:waypoint x="845" y="260" />
        <di:waypoint x="950" y="260" />
        <di:waypoint x="950" y="198" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="Participant_Sistema_di" bpmnElement="Participant_Sistema" isHorizontal="true">
        <dc:Bounds x="130" y="310" width="950" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Validar_di" bpmnElement="Task_Validar">
        <dc:Bounds x="250" y="350" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Validacion_di" bpmnElement="Gateway_Validacion" isMarkerVisible="true">
        <dc:Bounds x="385" y="365" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="350" y="390" />
        <di:waypoint x="385" y="390" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="MessageFlow_EnviarCredenciales_di" bpmnElement="MessageFlow_EnviarCredenciales">
        <di:waypoint x="300" y="220" />
        <di:waypoint x="300" y="350" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="MessageFlow_LoginOK_di" bpmnElement="MessageFlow_LoginOK">
        <di:waypoint x="410" y="365" />
        <di:waypoint x="410" y="180" />
        <di:waypoint x="460" y="180" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="420" y="270" width="11" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="MessageFlow_LoginError_di" bpmnElement="MessageFlow_LoginError">
        <di:waypoint x="410" y="415" />
        <di:waypoint x="410" y="445" />
        <di:waypoint x="220" y="445" />
        <di:waypoint x="220" y="190" />
        <di:waypoint x="250" y="190" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="310" y="427" width="15" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
