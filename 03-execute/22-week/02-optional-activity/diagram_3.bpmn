<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Aprendiz" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.50.1">
  <bpmn:collaboration id="Collaboration_Aprendiz">
    <bpmn:participant id="Participant_Aprendiz" name="Usuario / Aprendiz" processRef="Process_Aprendiz" />
    <bpmn:participant id="Participant_Sistema" name="Sistema (Autenticación y Backend)" processRef="Process_Sistema" />
    <bpmn:messageFlow id="MessageFlow_EnviarCredenciales" name="Enviar Credenciales" sourceRef="Task_Ingresar" targetRef="Task_Validar" />
    <bpmn:messageFlow id="MessageFlow_LoginOK" name="Sí" sourceRef="Gateway_Validacion" targetRef="Task_CargarPanel" />
    <bpmn:messageFlow id="MessageFlow_LoginError" name="No" sourceRef="Gateway_Validacion" targetRef="Task_Ingresar" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Aprendiz" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="Acceso a la Plataforma">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_Ingresar" name="Ingresar Correo y Contraseña">
      <bpmn:incoming>Flow_1</bpmn:incoming>
    </bpmn:userTask>
    <bpmn:userTask id="Task_CargarPanel" name="Cargar Panel Principal (Aprendiz)">
      <bpmn:outgoing>Flow_Menu</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Menu" name="Seleccionar Opción Menú">
      <bpmn:incoming>Flow_Menu</bpmn:incoming>
      <bpmn:outgoing>Flow_IrHorario</bpmn:outgoing>
      <bpmn:outgoing>Flow_IrNotificaciones</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_ConsultarHorario" name="Consultar Mi Horario (Ficha)">
      <bpmn:incoming>Flow_IrHorario</bpmn:incoming>
      <bpmn:outgoing>Flow_Fin1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent_1" name="Gestión Finalizada">
      <bpmn:incoming>Flow_Fin1</bpmn:incoming>
      <bpmn:incoming>Flow_Fin2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_Ingresar" />
    <bpmn:sequenceFlow id="Flow_Menu" sourceRef="Task_CargarPanel" targetRef="Gateway_Menu" />
    <bpmn:sequenceFlow id="Flow_IrHorario" name="Mi horario" sourceRef="Gateway_Menu" targetRef="Task_ConsultarHorario" />
    <bpmn:sequenceFlow id="Flow_IrNotificaciones" name="Notificaciones" sourceRef="Gateway_Menu" targetRef="Task_VerNotificaciones" />
    <bpmn:sequenceFlow id="Flow_Fin1" sourceRef="Task_ConsultarHorario" targetRef="EndEvent_1" />
    <bpmn:sequenceFlow id="Flow_Fin2" sourceRef="Task_VerNotificaciones" targetRef="EndEvent_1" />
    <bpmn:userTask id="Task_VerNotificaciones" name="Ver Notificaciones">
      <bpmn:incoming>Flow_IrNotificaciones</bpmn:incoming>
      <bpmn:outgoing>Flow_Fin2</bpmn:outgoing>
    </bpmn:userTask>
  </bpmn:process>
  <bpmn:process id="Process_Sistema" isExecutable="true">
    <bpmn:serviceTask id="Task_Validar" name="Validar Credenciales y Rol de Aprendiz">
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Validacion" name="¿Credenciales Válidas?">
      <bpmn:incoming>Flow_3</bpmn:incoming>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_Validar" targetRef="Gateway_Validacion" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_Aprendiz">
      <bpmndi:BPMNShape id="Participant_Aprendiz_di" bpmnElement="Participant_Aprendiz" isHorizontal="true">
        <dc:Bounds x="130" y="80" width="880" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="182" y="142" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Ingresar_di" bpmnElement="Task_Ingresar">
        <dc:Bounds x="250" y="120" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CargarPanel_di" bpmnElement="Task_CargarPanel">
        <dc:Bounds x="460" y="120" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Menu_di" bpmnElement="Gateway_Menu" isMarkerVisible="true">
        <dc:Bounds x="595" y="135" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="587" y="186" width="66" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ConsultarHorario_di" bpmnElement="Task_ConsultarHorario">
        <dc:Bounds x="700" y="90" width="110" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_1_di" bpmnElement="EndEvent_1">
        <dc:Bounds x="902" y="142" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="840.5" y="146" width="51" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_VerNotificaciones_di" bpmnElement="Task_VerNotificaciones">
        <dc:Bounds x="700" y="200" width="110" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="218" y="160" />
        <di:waypoint x="250" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Menu_di" bpmnElement="Flow_Menu">
        <di:waypoint x="560" y="160" />
        <di:waypoint x="595" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_IrHorario_di" bpmnElement="Flow_IrHorario">
        <di:waypoint x="620" y="135" />
        <di:waypoint x="620" y="120" />
        <di:waypoint x="700" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_IrNotificaciones_di" bpmnElement="Flow_IrNotificaciones">
        <di:waypoint x="620" y="185" />
        <di:waypoint x="620" y="230" />
        <di:waypoint x="700" y="230" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="585" y="213" width="69" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Fin1_di" bpmnElement="Flow_Fin1">
        <di:waypoint x="810" y="120" />
        <di:waypoint x="920" y="120" />
        <di:waypoint x="920" y="142" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Fin2_di" bpmnElement="Flow_Fin2">
        <di:waypoint x="810" y="230" />
        <di:waypoint x="920" y="230" />
        <di:waypoint x="920" y="178" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="Participant_Sistema_di" bpmnElement="Participant_Sistema" isHorizontal="true">
        <dc:Bounds x="130" y="280" width="880" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Validar_di" bpmnElement="Task_Validar">
        <dc:Bounds x="250" y="320" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Validacion_di" bpmnElement="Gateway_Validacion" isMarkerVisible="true">
        <dc:Bounds x="385" y="335" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="350" y="360" />
        <di:waypoint x="385" y="360" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="MessageFlow_EnviarCredenciales_di" bpmnElement="MessageFlow_EnviarCredenciales">
        <di:waypoint x="300" y="200" />
        <di:waypoint x="300" y="320" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="MessageFlow_LoginOK_di" bpmnElement="MessageFlow_LoginOK">
        <di:waypoint x="410" y="335" />
        <di:waypoint x="410" y="160" />
        <di:waypoint x="460" y="160" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="420" y="240" width="11" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="MessageFlow_LoginError_di" bpmnElement="MessageFlow_LoginError">
        <di:waypoint x="410" y="385" />
        <di:waypoint x="410" y="415" />
        <di:waypoint x="220" y="415" />
        <di:waypoint x="220" y="170" />
        <di:waypoint x="250" y="170" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="310" y="397" width="15" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
